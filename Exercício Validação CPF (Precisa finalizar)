#include <stdio.h>
#include <stdlib.h>

int main(int argc, char *argv[]) {
	int num1, num2, num3, num4, num5, num6, num7, num8, num9;
	int digito1, digito2;
	int mnum1, mnum2, mnum3, mnum4, mnum5, mnum6, mnum7, mnum8, mnum9;
	int resto1, resto2, soma, mdv;
	
	printf("Digite o CPF no formato 000.000.000-00: ");
	scanf("%d %d %d . %d %d %d . %d %d %d - %d %d",
	&num1, &num2, &num3, &num4, &num5, &num6, &num7, &num8, &num9, &digito1, &digito2);
	
	printf("O CPF que voce inseriu: %d%d%d.%d%d%d.%d%d%d-%d%d",
	num1, num2, num3, num4, num5, num6, num7, num8, num9, digito1, digito2);
	
	/* Calculo do primeiro digito */
	mnum1 = num1 * 10;
	mnum2 = num2 * 9;
	mnum3 = num3 * 8;
	mnum4 = num4 * 7;
	mnum5 = num5 * 6;
	mnum6 = num6 * 5;
	mnum7 = num7 * 4;
	mnum8 = num8 * 3;
	mnum9 = num9 * 2;
	
	soma = mnum1 + mnum2 + mnum3 + mnum4 + mnum5 + mnum6 + mnum7 + mnum8 + mnum9;
	soma = soma * 10;
	resto1 = soma % 11;
	
	if (resto1 == 10) {
		resto1 = 0;
	}
	
	/* Calculo do segundo digito */
	mnum1 = num1 * 11;
	mnum2 = num2 * 10;
	mnum3 = num3 * 9;
	mnum4 = num4 * 8;
	mnum5 = num5 * 7;
	mnum6 = num6 * 6;
	mnum7 = num7 * 5;
	mnum8 = num8 * 4;
	mnum9 = num9 * 3;
	
	mdv = digito1 * 2;
	
	soma = mnum1 + mnum2 + mnum3 + mnum4 + mnum5 + mnum6 + mnum7 + mnum8 + mnum9 + mdv;
	soma = soma * 10;
	resto2 = soma % 11;
	
	if (resto2 == 10) {
		resto2 = 0;
	}
	
	/* Verificacao */
	if (resto1 == digito1 && resto2 == digito2) {
		printf("\nCPF valido!");
	} else {
		printf("\nCPF invalido!");
	}
	
	return 0;
}
